generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  email     String @unique

  avatarId String?
  avatar   File?   @relation("UserAvatar", fields: [avatarId], references: [id])

  password     String?
  refreshToken String?
  isVerified   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships WorkspaceMember[]
  messages    Message[]

  files            File[]            @relation("UserFiles")
  roomMembers      RoomMember[]
  messageReceipts  MessageReceipt[]
  messageReactions MessageReaction[]
}

model Workspace {
  id   String @id @default(uuid())
  name String

  avatarId String?
  avatar   File?   @relation("WorkspaceAvatar", fields: [avatarId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkspaceMember[]
  rooms   Room[]
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  BUSY
}

model WorkspaceMember {
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  status     UserStatus @default(OFFLINE)
  lastSeenAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
}

model Room {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  type        RoomType
  isArchived  Boolean  @default(false)

  uniqueKey String? @unique // for direct rooms workspaceId_userId1_userId2

  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  messages       Message[]
  roomMembers    RoomMember[]
  pinnedMessages PinnedMessage[]
}

enum RoomType {
  PUBLIC // everyone in workspace
  PRIVATE // selected members
  DIRECT // 1-to-1 chat
}

model RoomMember {
  userId     String
  roomId     String
  lastReadAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@index([userId])
  @@index([roomId])
}

model Message {
  id        String    @id @default(uuid())
  roomId    String
  senderId  String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isEdited  Boolean   @default(false)
  deletedAt DateTime?

  parentId String?
  parent   Message?  @relation("MessageThread", fields: [parentId], references: [id])
  replies  Message[] @relation("MessageThread")

  room   Room @relation(fields: [roomId], references: [id])
  sender User @relation(fields: [senderId], references: [id])

  attachments      File[]
  messageReceipts  MessageReceipt[]
  messageReactions MessageReaction[]
  pinnedMessages   PinnedMessage[]

  @@index([parentId])
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

model MessageReceipt {
  messageId String
  userId    String
  status    MessageStatus
  updatedAt DateTime      @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model PinnedMessage {
  messageId String @id
  roomId    String

  message Message @relation(fields: [messageId], references: [id])
  room    Room    @relation(fields: [roomId], references: [id])
}

model Otp {
  id        String   @id @default(uuid())
  userId    String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model File {
  id          String     @id @default(uuid())
  filename    String
  key         String
  mimetype    String
  size        Int
  status      FileStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  kind        FileKind   @default(FILE)
  durationSec Int?

  userId String
  user   User   @relation("UserFiles", fields: [userId], references: [id], onDelete: Cascade)

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id])

  avatarOfUsers      User[]      @relation("UserAvatar")
  avatarOfWorkspaces Workspace[] @relation("WorkspaceAvatar")

  @@index([userId])
  @@index([messageId])
}

enum FileStatus {
  PENDING
  ATTACHED
}

enum FileKind {
  IMAGE
  FILE
  VOICE
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
